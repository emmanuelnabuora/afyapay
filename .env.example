# Dummy values only. Never put real secrets in this file.
PORT=3000
DATABASE_URL=postgres://afyapay:afyapay@localhost:5432/afyapay_dev
APP_ENV=development
# Any 32+ character dummy string locally. Staging gets a generated value from Render.
AUTH_SECRET=dev-only-not-a-secret-change-me-0000000000
# Part of the M-Pesa callback URL. Any 16+ character dummy string locally.
MPESA_CALLBACK_SECRET=dev-only-callback-path-000000
# Public URL Safaricom calls back. Render sets RENDER_EXTERNAL_URL itself.
PUBLIC_BASE_URL=http://localhost:3000
# Only for collection accounts in daraja_sandbox mode. Dummy values here.
DARAJA_CONSUMER_KEY=dummy-consumer-key
DARAJA_CONSUMER_SECRET=dummy-consumer-secret
# Encrypts insurer staff authenticator secrets. Any 32+ character dummy string locally.
MFA_SECRET_KEY=dev-only-mfa-key-not-a-secret-00000000
PII_ENCRYPTION_KEY=dev-only-pii-key-not-a-secret-000000000
# Only during a key rotation (docs/runbooks/secret-rotation.md): the OLD value, still accepted or read.
# PII_ENCRYPTION_KEY_PREVIOUS=
# MFA_SECRET_KEY_PREVIOUS=
# MPESA_CALLBACK_SECRET_PREVIOUS=
# Shown to customers in the app footer when set. Dummy values here.
SUPPORT_PHONE=
SUPPORT_EMAIL=
# API requests a minute per signed-in client and per address without a token. 0 turns a limit off (load tests only).
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_ANON_PER_MINUTE=600
